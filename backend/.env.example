# LLM Provider Configuration 
LLM_PROVIDER=gemini

# Google Gemini Configuration (Default)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash



# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./data/contracts.db

# LLM Resilience & Timeouts
LLM_MAX_RETRIES=3
LLM_RETRY_MIN_WAIT=1.0
LLM_RETRY_MAX_WAIT=10.0
LLM_TIMEOUT_SECONDS=30.0
MAX_PAYLOAD_CHARS=50000

# CORS Configuration
FRONTEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
