# LLM Provider Configuration ("gemini" or "openai")
LLM_PROVIDER=gemini

# Google Gemini Configuration (Default)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./contracts.db

# LLM Resilience & Timeouts
LLM_MAX_RETRIES=3
LLM_RETRY_MIN_WAIT=1.0
LLM_RETRY_MAX_WAIT=10.0
LLM_TIMEOUT_SECONDS=30.0
MAX_PAYLOAD_CHARS=50000
